{
  "name": "zuohen-ev-site",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "audit:assets": "node scripts/audit-assets.mjs",
    "news:sync": "node scripts/sync-news.mjs",
    "news:sync:remote": "node scripts/sync-news.mjs --remote",
    "db:migrate:local": "wrangler d1 migrations apply zuohen-news --local",
    "db:migrate:remote": "wrangler d1 migrations apply zuohen-news --remote",
    "products:check": "node scripts/check-products.mjs",
    "deploy": "npm run audit:assets && npm run db:migrate:remote && npm run news:sync:remote && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}