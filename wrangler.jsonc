{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zuohen-ev-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "NEWS_DB",
      "database_name": "zuohen-news",
      "database_id": "087459df-428f-4fcd-8d78-fdc40bf99d30"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}